generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String  @id @default(cuid())
  name        String
  title       String
  bio         String
  avatarUrl   String?
  resumeUrl   String?
  githubUrl   String?
  linkedinUrl String?
  email       String
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  // Store tools and metrics as JSON-encoded strings.
  tools       String
  metrics     String
  githubUrl   String?
  demoUrl     String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Skill {
  id       String @id @default(cuid())
  name     String
  category String

  @@unique([name, category])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  visitorId String
  eventType String
  target    String?
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([visitorId, createdAt])
}
