# Prisma Postgres direct URL: used by Prisma CLI migrations and seeding.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional pooled URL: used by the serverless application runtime on Vercel.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLED_HOST:5432/DATABASE?sslmode=require"
# Use a long, unique password (32+ characters recommended).
ADMIN_PASSWORD="replace-with-a-long-random-password"
